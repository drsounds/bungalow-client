{
	"name": "bungalow-client",
	"version-string": "1.0.0",
    "builtin-baseline": "e456309491fd875487bf02b8a0dca76c1b1b00cc",
	"dependencies": [
		"nlohmann-json",
		"lua",
        "wtl",
		"libpng",
		"expat",
		"sqlite3"
	],
	"features": {
		"wxwidgets": {
			"description": "Dependencies for the wxWidgets UI backend",
			"dependencies": [
				{
					"name": "wxwidgets",
					"features": ["webview"]
				}
			]
		},
		"cef": {
			"description": "Chromium Embedded Framework for local HTML5 app bundles (BUNGALOW_ENABLE_CEF)",
			"dependencies": [
				{
					"name": "cef",
					"platform": "windows & x64"
				}
			]
		}
	},
	"vcpkg-configuration": {
		"overlay-ports": ["./ports"]
	}
}
