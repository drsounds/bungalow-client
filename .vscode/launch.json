    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug spacify-client (WTL)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ninja/spacify-client.exe",
            "args": [],
            "cwd": "${workspaceFolder}/build/ninja",
            "preLaunchTask": "CMake: build"
        },
        {
            "type": "cmake",
            "request": "launch",
            "name": "CMake: Configure project",
            "cmakeDebugType": "configure",
            "scriptPath": "${workspaceFolder}/CMakeLists.txt",
            "clean": false,
            "configureAll": false
        }
    ]
}